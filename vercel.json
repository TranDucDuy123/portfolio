{
  "cleanUrls": true,
  "redirects": [
    { "source": "/pricing", "destination": "/bao-gia", "permanent": true },
    { "source": "/chien-luoc/tu-van-hosting.html", "destination": "/cafe-so/hosting-la-gi", "permanent": true },
    { "source": "/chien-luoc/tu-van-hosting", "destination": "/cafe-so/hosting-la-gi", "permanent": true }
  ],
  "rewrites": [
    { "source": "/projects/:slug", "destination": "/" },
    { "source": "/bao-gia/coach-tran-cong", "destination": "/" },
    { "source": "/bao-gia-tran-cong", "destination": "/" },
    { "source": "/tu-van-mks", "destination": "/" },
    { "source": "/tu-van-hosting-mks", "destination": "/" },
    { "source": "/de-xuat-mks", "destination": "/" },
    { "source": "/van-tai-mks", "destination": "/" },
    { "source": "/video", "destination": "/" },
    { "source": "/ke-hoach/:slug", "destination": "/" },
    { "source": "/bao-gia-kh/:slug", "destination": "/" }
  ],
  "headers": [
    {
      "source": "/video",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex" }]
    },
    {
      "source": "/ke-hoach/(.*)",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow, noarchive" }]
    },
    {
      "source": "/de-xuat/(.*)",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow, noarchive" }]
    },
    {
      "source": "/mat-kinh-long-an",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow, noarchive" }]
    },
    {
      "source": "/gio-qua-trai-cay-350",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow, noarchive" }]
    },
    {
      "source": "/mkla/(.*)",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow, noarchive" }]
    },
    {
      "source": "/bao-gia-kh/(.*)",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow, noarchive" }]
    },
    {
      "source": "/noi-bo/(.*)",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow, noarchive" },
        { "key": "Cache-Control", "value": "no-store" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "no-referrer" }
      ]
    },
    {
      "source": "/kh-data/(.*)",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, nofollow, noarchive" },
        { "key": "Cache-Control", "value": "no-cache" }
      ]
    }
  ]
}
